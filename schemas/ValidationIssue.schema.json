{
  "$defs": {
    "IssueCode": {
      "enum": [
        "GSTIN_CHECKSUM",
        "GSTIN_STATE_MISMATCH",
        "TAX_REGIME_MISMATCH",
        "LINE_ARITHMETIC",
        "TOTAL_MISMATCH",
        "DUPLICATE_INVOICE",
        "VENDOR_UNKNOWN",
        "LOW_CONFIDENCE",
        "MISSING_FIELD",
        "ROUND_OFF_EXCEEDED"
      ],
      "title": "IssueCode",
      "type": "string"
    },
    "IssueSeverity": {
      "enum": [
        "info",
        "warn",
        "error"
      ],
      "title": "IssueSeverity",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "code": {
      "$ref": "#/$defs/IssueCode"
    },
    "evidence": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Evidence"
    },
    "field": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Field"
    },
    "message": {
      "title": "Message",
      "type": "string"
    },
    "severity": {
      "$ref": "#/$defs/IssueSeverity"
    }
  },
  "required": [
    "code",
    "severity",
    "message"
  ],
  "title": "ValidationIssue",
  "type": "object"
}
