{
  "$defs": {
    "DecisionOutcome": {
      "enum": [
        "ALLOW",
        "REVIEW",
        "BLOCK"
      ],
      "title": "DecisionOutcome",
      "type": "string"
    },
    "IssueCode": {
      "enum": [
        "GSTIN_CHECKSUM",
        "GSTIN_STATE_MISMATCH",
        "TAX_REGIME_MISMATCH",
        "LINE_ARITHMETIC",
        "TOTAL_MISMATCH",
        "DUPLICATE_INVOICE",
        "VENDOR_UNKNOWN",
        "LOW_CONFIDENCE",
        "MISSING_FIELD",
        "ROUND_OFF_EXCEEDED"
      ],
      "title": "IssueCode",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "grand_total": {
      "title": "Grand Total",
      "type": "string"
    },
    "invoice_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Invoice Date"
    },
    "invoice_id": {
      "format": "uuid",
      "title": "Invoice Id",
      "type": "string"
    },
    "invoice_number": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Invoice Number"
    },
    "issue_count": {
      "minimum": 0,
      "title": "Issue Count",
      "type": "integer"
    },
    "outcome": {
      "$ref": "#/$defs/DecisionOutcome"
    },
    "posted": {
      "default": false,
      "title": "Posted",
      "type": "boolean"
    },
    "top_issue_code": {
      "anyOf": [
        {
          "$ref": "#/$defs/IssueCode"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "vendor_gstin": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Vendor Gstin"
    },
    "vendor_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Vendor Name"
    }
  },
  "required": [
    "invoice_id",
    "grand_total",
    "outcome",
    "issue_count"
  ],
  "title": "ReviewQueueItem",
  "type": "object"
}
