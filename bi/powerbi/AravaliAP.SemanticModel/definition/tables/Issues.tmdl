table Issues
	lineageTag: a1000003-0000-4000-8000-000000000003

	column invoice_id
		dataType: string
		summarizeBy: none
		sourceColumn: invoice_id

	column code
		dataType: string
		summarizeBy: none
		sourceColumn: code

	column severity
		dataType: string
		summarizeBy: none
		sourceColumn: severity

	column field
		dataType: string
		summarizeBy: none
		sourceColumn: field

	partition Issues = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents(DataFolder & "issues.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
			    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
			    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"invoice_id", type text}}, "en-US")
			in
			    #"Changed Type"
