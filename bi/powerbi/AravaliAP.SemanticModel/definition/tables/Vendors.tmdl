table Vendors
	lineageTag: a1000005-0000-4000-8000-000000000005

	column vendor_id
		dataType: string
		summarizeBy: none
		sourceColumn: vendor_id

	column legal_name
		dataType: string
		summarizeBy: none
		sourceColumn: legal_name

	column gstin
		dataType: string
		summarizeBy: none
		sourceColumn: gstin

	column state_code
		dataType: string
		summarizeBy: none
		sourceColumn: state_code

	column pan
		dataType: string
		summarizeBy: none
		sourceColumn: pan

	column bank_last4
		dataType: string
		summarizeBy: none
		sourceColumn: bank_last4

	partition Vendors = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents(DataFolder & "vendors.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
			    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
			    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"vendor_id", type text}}, "en-US")
			in
			    #"Changed Type"
