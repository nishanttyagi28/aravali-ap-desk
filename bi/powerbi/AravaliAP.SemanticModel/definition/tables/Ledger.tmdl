table Ledger
	lineageTag: a1000004-0000-4000-8000-000000000004

	column entry_id
		dataType: string
		summarizeBy: none
		sourceColumn: entry_id

	column seq
		dataType: int64
		summarizeBy: none
		sourceColumn: seq

	column invoice_id
		dataType: string
		summarizeBy: none
		sourceColumn: invoice_id

	column vendor_id
		dataType: string
		summarizeBy: none
		sourceColumn: vendor_id

	column taxable_total
		dataType: double
		summarizeBy: sum
		sourceColumn: taxable_total

	column cgst_total
		dataType: double
		summarizeBy: sum
		sourceColumn: cgst_total

	column sgst_total
		dataType: double
		summarizeBy: sum
		sourceColumn: sgst_total

	column igst_total
		dataType: double
		summarizeBy: sum
		sourceColumn: igst_total

	column cess_total
		dataType: double
		summarizeBy: sum
		sourceColumn: cess_total

	column grand_total
		dataType: double
		summarizeBy: sum
		sourceColumn: grand_total

	column posted_at
		dataType: string
		summarizeBy: none
		sourceColumn: posted_at

	column receipt_sha256
		dataType: string
		summarizeBy: none
		sourceColumn: receipt_sha256

	column prev_receipt_sha256
		dataType: string
		summarizeBy: none
		sourceColumn: prev_receipt_sha256

	column seal_provider
		dataType: string
		summarizeBy: none
		sourceColumn: seal_provider

	column seal_commit_id
		dataType: string
		summarizeBy: none
		sourceColumn: seal_commit_id

	column seal_manifest_sha256
		dataType: string
		summarizeBy: none
		sourceColumn: seal_manifest_sha256

	column seal_witness_status
		dataType: string
		summarizeBy: none
		sourceColumn: seal_witness_status

	partition Ledger = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents(DataFolder & "ledger.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
			    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
			    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers", {{"invoice_id", type text}, {"seq", Int64.Type}, {"taxable_total", type number}, {"cgst_total", type number}, {"sgst_total", type number}, {"igst_total", type number}, {"cess_total", type number}, {"grand_total", type number}}, "en-US")
			in
			    #"Changed Type"
